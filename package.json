{
  "name": "gamert",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GAMERT — plataforma de torneos de juegos. Frontend generado desde los prototipos Figma.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:gen": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --outfile=scripts/.generate-seed.mjs --log-level=warning && node scripts/.generate-seed.mjs",
    "db:check": "node scripts/check-db.ts",
    "types:gen": "node scripts/gen-types.ts && prettier --write src/lib/api/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
